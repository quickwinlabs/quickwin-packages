{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": false,
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    // quickwin.d.ts 提供 ffi / gui / os 等 QuickWin 运行时内建的环境声明（非 npm 包）。
    // 相对路径指向本包 node_modules（publish workflow 在包内 `npm install`）。
    "types": ["./node_modules/quickwin/quickwin.d.ts"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
